# Solo para desarrollo local. El producto distribuido usara el gateway.
GCP_PROJECT_ID=bubbly-stone-502214-u7
GCP_REGION=us-east4

# Modo voz (microfono prendido): Live API, modelo de audio nativo. No acepta
# texto de salida, por eso el modo texto usa un modelo aparte (mas abajo).
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Modo texto (escribir en el chat): pedido HTTP normal (generateContent), sin
# Live API y sin tokens de audio. Barato aunque la visualizacion este prendida.
GEMINI_TEXT_MODEL=gemini-2.5-flash
